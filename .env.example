# Copy this file to .env and fill in your values

# PostgreSQL connection string
# For Azure: postgresql://user:password@server.postgres.database.azure.com:5432/dbname?sslmode=require
# For local: postgresql://user:password@localhost:5432/dbname
DATABASE_URL=

# JWT secret for session tokens (generate with: openssl rand -base64 32)
JWT_SECRET=

# Azure Blob Storage (for photo uploads)
# Create with: az storage account create --name <name> --resource-group <rg> --sku Standard_LRS
# Then: az storage container create --name photos --account-name <name> --public-access off
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=

# Anthropic API (for AI-powered baby name generation)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Recipient names for friend letters (optional, defaults shown)
# RECIPIENT_NAME_YOU=Dylan
# RECIPIENT_NAME_PARTNER=Partner
# RECIPIENT_NAME_BABY=Baby
# The client bakes the same names in at build time from VITE_RECIPIENT_NAME_YOU,
# VITE_RECIPIENT_NAME_PARTNER and VITE_RECIPIENT_NAME_BABY (in client/.env, or
# the RECIPIENT_NAME_* repository variables for the deploy workflow).
