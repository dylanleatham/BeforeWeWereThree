// Prisma schema for Before We Were Three
// Database: PostgreSQL (Azure Flexible Server)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Application configuration key-value store
// Used for PIN, feature flags, and other app settings
model AppConfig {
  key   String @id
  value String

  @@map("app_config")
}

// Participant tracking for device sessions
// Supports two designated participants (A, B) plus readonly viewers
model Participant {
  id                String   @id @default(uuid())
  deviceFingerprint String   @unique @map("device_fingerprint")
  designation       String? // 'A', 'B', or 'readonly' (null for admin participants)
  role              String // 'guest', 'admin', or 'friend'
  friendId          String?  @map("friend_id")
  createdAt         DateTime @default(now()) @map("created_at")

  friend            Friend?  @relation(fields: [friendId], references: [id], onDelete: Restrict)
  wyrVotes          WyrVote[]
  letters           Letter[]
  photos            Photo[]
  nameGameVotes     NameGameVote[]
  nameGameGuidance  NameGameGuidance[]
  triviaAnswers     TriviaAnswer[]

  @@index([friendId])
  @@map("participants")
}

// Envelope activity container
// Each envelope holds one activity (Would You Rather, Letter, Trivia, etc.)
model Envelope {
  id             String   @id @default(uuid())
  title          String   // Display title (e.g., "Would You Rather #1")
  type           String   // Activity type: 'would-you-rather' | 'letter' | 'trivia' | 'name-game' | 'gender-reveal' | 'friend-letter'
  status         String   @default("sealed") // 'sealed' | 'opened' | 'completed'
  order          Int      // Display order in pile
  friendLetterId String?  @unique @map("friend_letter_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  friendLetter   FriendLetter?  @relation(fields: [friendLetterId], references: [id], onDelete: Restrict)
  wyrPrompts                WyrPrompt[]
  letterPrompt              LetterPrompt?
  nameGameRounds            NameGameRound[]
  triviaEnvelopeQuestions   TriviaEnvelopeQuestion[]
  triviaAnswers             TriviaAnswer[]
  genderRevealConfig        GenderRevealConfig?

  @@map("envelopes")
}

// Would You Rather prompt
// Multiple prompts per envelope, ordered by sortOrder
model WyrPrompt {
  id         String   @id @default(uuid())
  envelopeId String   @map("envelope_id")
  optionA    String   @map("option_a")
  optionB    String   @map("option_b")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  envelope Envelope  @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  votes    WyrVote[]

  @@unique([envelopeId, sortOrder])
  @@index([envelopeId])
  @@map("wyr_prompts")
}

// Would You Rather vote
// Tracks each participant's choice for a prompt
model WyrVote {
  id            String   @id @default(uuid())
  promptId      String   @map("prompt_id")
  participantId String   @map("participant_id")
  choice        String   // 'option_a' or 'option_b'
  createdAt     DateTime @default(now()) @map("created_at")

  prompt      WyrPrompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([promptId, participantId])
  @@index([participantId])
  @@map("wyr_votes")
}

// Letter prompt
// Admin creates a prompt that guides what participants write about
model LetterPrompt {
  id         String   @id @default(uuid())
  envelopeId String   @unique @map("envelope_id")
  prompt     String   // The question/prompt text admin creates
  createdAt  DateTime @default(now()) @map("created_at")

  envelope Envelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  letters  Letter[]

  @@map("letter_prompts")
}

// Letter content
// Each participant writes one letter per prompt
model Letter {
  id            String    @id @default(uuid())
  promptId      String    @map("prompt_id")
  participantId String    @map("participant_id")
  content       String    @default("")
  photoUrl      String?   @map("photo_url")
  submittedAt   DateTime? @map("submitted_at") // null = draft, set = submitted
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  prompt      LetterPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  participant Participant  @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([promptId, participantId])
  @@index([participantId])
  @@index([promptId])
  @@map("letters")
}

// Photo uploaded to Azure Blob Storage
// Tracks metadata for uploaded photos
model Photo {
  id           String   @id @default(uuid())
  blobUrl      String   @unique @map("blob_url")
  filename     String
  contentType  String   @map("content_type")
  uploadedById String   @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  uploadedBy Participant @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([uploadedById])
  @@map("photos")
}

// Name Game round - one round per "Start Round" button press
model NameGameRound {
  id          String   @id @default(uuid())
  envelopeId  String   @map("envelope_id")
  roundNumber Int      @map("round_number")
  guidance    String?  // User's free-text guidance for AI (null for first round)
  status      String   @default("ready") // 'generating' | 'ready'
  createdAt   DateTime @default(now()) @map("created_at")

  envelope Envelope       @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  names    NameGameName[]

  @@unique([envelopeId, roundNumber])
  @@index([envelopeId])
  @@map("name_game_rounds")
}

// Individual generated name within a round
model NameGameName {
  id        String   @id @default(uuid())
  roundId   String   @map("round_id")
  name      String
  origin    String[] // PostgreSQL text array for multiple origins
  meaning   String
  notes     String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  round NameGameRound  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  votes NameGameVote[]

  @@index([roundId])
  @@map("name_game_names")
}

// Guidance submission for coordinated round generation
// Tracks which participants have submitted readiness/preferences for the next round
model NameGameGuidance {
  id            String   @id @default(uuid())
  envelopeId    String   @map("envelope_id")
  roundNumber   Int      @map("round_number")
  participantId String   @map("participant_id")
  guidance      String?
  createdAt     DateTime @default(now()) @map("created_at")

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([envelopeId, roundNumber, participantId])
  @@index([envelopeId, roundNumber])
  @@index([participantId])
  @@map("name_game_guidance")
}

// Vote on a name by a participant
model NameGameVote {
  id            String   @id @default(uuid())
  nameId        String   @map("name_id")
  participantId String   @map("participant_id")
  choice        String   // 'love', 'maybe', or 'nope'
  createdAt     DateTime @default(now()) @map("created_at")

  name        NameGameName @relation(fields: [nameId], references: [id], onDelete: Cascade)
  participant Participant  @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([nameId, participantId])
  @@index([participantId])
  @@map("name_game_votes")
}

// Friend - a friend of the couple who writes letters
model Friend {
  id             String   @id @default(uuid())
  name           String
  pin            String   @unique
  isGenderKeeper Boolean  @default(false) @map("is_gender_keeper")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  participants       Participant[]
  friendLetters      FriendLetter[]
  thankYouNote       FriendThankYouNote?
  genderRevealConfigs GenderRevealConfig[]

  @@map("friends")
}

// Personalized thank-you note from couple to friend (written by admin)
model FriendThankYouNote {
  id        String   @id @default(uuid())
  friendId  String   @unique @map("friend_id")
  content   String
  mediaUrl  String?  @map("media_url")
  mediaType String?  @map("media_type") // 'image' | 'video' | 'audio'
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  friend Friend @relation(fields: [friendId], references: [id], onDelete: Restrict)

  @@map("friend_thank_you_notes")
}

// Letter a friend writes to a recipient
model FriendLetter {
  id          String    @id @default(uuid())
  friendId    String    @map("friend_id")
  recipient   String    // 'you' | 'partner' | 'baby'
  title       String?
  content     String    @default("")
  mediaUrl    String?   @map("media_url")
  mediaType   String?   @map("media_type") // 'image' | 'video' | 'audio'
  submittedAt DateTime? @map("submitted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  friend   Friend    @relation(fields: [friendId], references: [id], onDelete: Restrict)
  envelope Envelope?

  @@index([friendId])
  @@map("friend_letters")
}

// Trivia question in content library
// Questions are standalone and assigned to envelopes via TriviaEnvelopeQuestion
model TriviaQuestion {
  id           String   @id @default(uuid())
  questionText String   @map("question_text")
  options      Json     // Array of { text: string, isCorrect: boolean }
  explanation  String?  // Optional "did you know" text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  envelopeAssignments TriviaEnvelopeQuestion[]
  triviaAnswers       TriviaAnswer[]

  @@map("trivia_questions")
}

// Join table: assigns trivia questions to envelopes with sort order
model TriviaEnvelopeQuestion {
  id         String @id @default(uuid())
  envelopeId String @map("envelope_id")
  questionId String @map("question_id")
  sortOrder  Int    @default(0) @map("sort_order")

  envelope Envelope       @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  question TriviaQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([envelopeId, questionId])
  @@unique([envelopeId, sortOrder])
  @@index([envelopeId])
  @@index([questionId])
  @@map("trivia_envelope_questions")
}

// Trivia answer submitted by a participant
model TriviaAnswer {
  id            String   @id @default(uuid())
  envelopeId    String   @map("envelope_id")
  questionId    String   @map("question_id")
  participantId String   @map("participant_id")
  selectedIndex Int      @map("selected_index")
  isCorrect     Boolean  @map("is_correct")
  createdAt     DateTime @default(now()) @map("created_at")

  envelope    Envelope       @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  question    TriviaQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  participant Participant    @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([envelopeId, questionId, participantId])
  @@index([envelopeId])
  @@index([questionId])
  @@index([participantId])
  @@map("trivia_answers")
}

// Gender reveal configuration
// One config per envelope, stores gender value and two unique keys
// Keys are validated by participants to trigger the reveal
model GenderRevealConfig {
  id              String    @id @default(uuid())
  envelopeId      String    @unique @map("envelope_id")
  genderValue     String?   @map("gender_value")  // 'boy' | 'girl' | null (until friend sets it)
  keyA            String    @map("key_a")          // 8-digit date (MMDDYYYY)
  keyB            String    @map("key_b")          // 8-digit date (MMDDYYYY)
  keyAValidated   Boolean   @default(false) @map("key_a_validated")
  keyBValidated   Boolean   @default(false) @map("key_b_validated")
  setByFriendId   String?   @map("set_by_friend_id")
  revealedAt      DateTime? @map("revealed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  envelope    Envelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  setByFriend Friend?  @relation(fields: [setByFriendId], references: [id], onDelete: SetNull)

  @@map("gender_reveal_configs")
}
