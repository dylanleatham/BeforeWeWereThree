// Prisma schema for Before We Were Three
// Database: PostgreSQL (Azure Flexible Server)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Application configuration key-value store
// Used for PIN, feature flags, and other app settings
model AppConfig {
  key   String @id
  value String

  @@map("app_config")
}

// Participant tracking for device sessions
// Supports two designated participants (A, B) plus readonly viewers
model Participant {
  id                String   @id @default(uuid())
  deviceFingerprint String   @unique @map("device_fingerprint")
  designation       String // 'A', 'B', or 'readonly'
  role              String // 'guest' or 'admin'
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("participants")
}

// Envelope activity container
// Each envelope holds one activity (Would You Rather, Letter, Trivia, etc.)
model Envelope {
  id        String   @id @default(uuid())
  title     String   // Display title (e.g., "Would You Rather #1")
  type      String   // Activity type: 'would-you-rather' | 'letter' | 'trivia' | 'name-game' | 'gender-reveal'
  status    String   @default("sealed") // 'sealed' | 'opened' | 'completed'
  order     Int      // Display order in pile
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("envelopes")
}
